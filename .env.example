# Copy to backend/.env (or export in your shell).

# Local default is SQLite. For Postgres: docker compose up -d, then:
# DATABASE_URL=postgresql+psycopg://rfqflow:rfqflow@localhost:5432/rfqflow
DATABASE_URL=sqlite:///./rfq_flow.db

# Optional: enables the LLM extraction path (falls back to a rules parser without one)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-4-5
